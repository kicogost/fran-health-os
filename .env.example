# Copy this file to .env and fill in real values. Never commit .env.
# .env is gitignored; this file (.env.example) is the only one that belongs in git.

# --- Garmin Connect (unofficial client: garminconnect / garth) ---
# Used for headless login. If your account has MFA enabled, first auth must be
# run interactively (see scripts docs once Phase 6 lands); garth then caches
# session tokens to disk so subsequent runs don't need these again.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Where garth caches session tokens after first login.
GARTH_TOKEN_DIR=data/.garth_tokens

# --- Strava API ---
# Create a personal API application at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Populated after the one-time OAuth flow; refreshed automatically by stravalib after that.
STRAVA_REFRESH_TOKEN=

# --- Apple Health, historical bulk export (native Health app, export.xml) ---
APPLE_HEALTH_EXPORT_DIR=data/raw/apple_health

# --- Apple Health, live weight sync (Health Auto Export iOS app, Premium
# tier, "iCloud Drive" automation) --- a DIFFERENT JSON format from the export
# above, not the same pipeline. Point this at wherever the app's iCloud Drive
# folder syncs down to locally -- NOT a folder you manually copy files into;
# real find 2026-08-29, this was left unset and silently fell back to a
# one-time manual test copy that nothing ever refreshed, so weight went
# stale for over a week without erroring. Find the real live folder with:
#   mdfind -name "<your automation's name>"
# (the automation's exact iCloud container path varies by app version/
# install and isn't guessable -- always verify it via mdfind, don't assume).
# scripts/sync.py reads every HealthAutoExport-*.json file found here.
HEALTH_AUTO_EXPORT_DIR=data/raw/health_auto_export

# --- Paths (override only if you move things off the defaults) ---
HEALTH_OS_DB_PATH=data/health.db

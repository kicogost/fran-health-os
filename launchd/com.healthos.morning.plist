<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Phase 8 scheduling (kickoff doc): runs scripts/morning_run.sh (sync +
  briefing + Sunday weekly retro) automatically every morning, so Francisco
  never has to trigger it by hand.

  Checked into the repo for the record, but launchd itself only reads from
  ~/Library/LaunchAgents/ -- installing this means copying it there (see
  "Setup" below), not just having it present in git. A per-user LaunchAgent,
  not a LaunchDaemon: this only needs to run as Francisco's own user (his
  .env, his data directory), never needs root, and only needs to run while
  he's logged in (a fresh morning briefing while the machine is asleep with
  nobody there to read it isn't useful anyway).

  Fires TWICE daily, Europe/Madrid: 07:00 and 09:30 (09:30 added 2026-08-29).
  07:00 alone (set the same day) covers ride-day early wake-ups, but Garmin
  only finalizes overnight sleep/HRV once the person actually wakes -- on a
  normal day Francisco wakes 8:30-9:00, so a 07:00-only schedule would just
  read stale/incomplete data on those days. 09:30 gives ~30-60min buffer
  after a normal wake for Garmin to finalize and sync that data, so a normal
  day still gets one genuinely fresh, complete briefing (the 07:00 run on
  those days may show a partial/last-night-not-fully-ready picture -- two
  notifications on those mornings is a real, accepted tradeoff for never
  missing either wake pattern, not an oversight). Adjust the Hour/Minute
  pairs below and reload if either time turns out wrong once lived with.
  StartCalendarInterval accepts an array of dicts for exactly this --
  multiple fixed wall-clock times, not "every N seconds since boot."

  Paired with com.healthos.quicksync.plist (evening, same directory) --
  this run alone can't see that day's own activities/weigh-in since they
  haven't happened yet; the evening pass catches those quietly so this
  morning run always has a complete picture of yesterday.

  Setup:
      cp launchd/com.healthos.morning.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.healthos.morning.plist

  Verify it's loaded:
      launchctl list | grep healthos

  Run it immediately (without waiting for 07:00), to test:
      launchctl start com.healthos.morning

  Remove it:
      launchctl unload ~/Library/LaunchAgents/com.healthos.morning.plist
      rm ~/Library/LaunchAgents/com.healthos.morning.plist

  Output: data/logs/morning_run.log (sync + briefing + retro text) and
  data/logs/launchd_stderr.log (anything launchd itself couldn't route
  through the script, e.g. if bash fails to even start).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.healthos.morning</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/franciscogostscagliarini/fitness man/scripts/morning_run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/franciscogostscagliarini/fitness man</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/franciscogostscagliarini/fitness man/data/logs/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/franciscogostscagliarini/fitness man/data/logs/launchd_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
